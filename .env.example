# Default: preview confirmations in the server console; no real mail is sent.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate and store a long random secret privately.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Vercel/database integrations normally provide this automatically.
# Keep blank for local SQLite development.
DATABASE_URL=

IVORY_EMAIL_MODE=console

# For live delivery: use the company's full Gmail / Google Workspace address,
# add its Google app password below, then change IVORY_EMAIL_MODE to smtp.
IVORY_GMAIL_ADDRESS=
IVORY_GMAIL_APP_PASSWORD=

# Optional AI fallback. Studio FAQs work with this blank.
# Use an OpenAI Platform project key with API billing, never a ChatGPT password.
# A valid key alone is not enough: the owning project needs available API quota.
# After changing these values, recreate the Compose service (restart is not enough).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Human-support automation. Five minutes is the safe default.
IVORY_SUPPORT_TIMEOUT_SECONDS=300
IVORY_SUPPORT_RATE_LIMIT=20
IVORY_SUPPORT_RATE_WINDOW=60
IVORY_SUPPORT_RETENTION_DAYS=90

# Keep false unless a trusted reverse proxy overwrites X-Forwarded-For.
IVORY_TRUST_PROXY_HEADERS=false
